// SISTEM INFORMASI RT 002 - BLOK MAWAR CIPTALAND
// Digital Operating System for RT 002 RW 014 Perumahan Ciptaland, Batam

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ WARGA (Residents) ============
model Warga {
  id             String   @id @default(cuid())
  nama           String
  nik            String?
  noKK           String?
  noRumah        String
  blok           String   @default("Mawar")
  alamat         String?
  telepon        String?
  email          String?
  jenisKelamin   String   @default("L") // L / P
  pekerjaan      String?
  statusKawin    String   @default("Belum Kawin")
  agama          String   @default("Islam")
  role           String   @default("warga") // warga / pengurus / admin
  jabatan        String?  // for pengurus
  foto           String?
  status         String   @default("aktif") // aktif / pindah / meninggal
  tanggalBergabung DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tagihan        Tagihan[]
  pengaduan      Pengaduan[]
  kwitansi       Kwitansi[]
  transaksi      Transaksi[]
  anggotaKK      AnggotaKK[]
}

// ============ ANGGOTA KK (Family members within a Kartu Keluarga) ============
model AnggotaKK {
  id          String    @id @default(cuid())
  wargaId     String    // warga (kepala KK) this anggota belongs to
  warga       Warga     @relation(fields: [wargaId], references: [id], onDelete: Cascade)
  nama        String
  nik         String?
  jenisKelamin String   @default("L") // L / P
  hubungan    String    @default("Anggota") // Kepala Keluarga / Istri / Anak / FAMILI LAIN
  tanggalLahir DateTime?
  createdAt   DateTime  @default(now())
}

// ============ USER (Auth / login accounts) ============
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String   // stored hashed (sha256 demo) — production use bcrypt/argon2
  nama       String
  role       String   @default("warga") // admin / ketua / bendahara / pengurus / warga
  wargaId    String?  // optional link to a Warga record
  telepon    String?
  foto       String?
  status     String   @default("aktif") // aktif / nonaktif
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ TRANSAKSI (Income / Expense) ============
model Transaksi {
  id          String   @id @default(cuid())
  kode        String   @unique
  jenis       String   // pemasukan / pengeluaran
  tanggal     DateTime
  kategori    String
  keterangan  String
  nominal     Int
  penerima    String?
  sumber      String?
  buktiUrl    String?
  metode      String   @default("Tunai") // Tunai / Transfer / QRIS
  status      String   @default("selesai") // selesai / pending
  wargaId     String?
  warga       Warga?   @relation(fields: [wargaId], references: [id])
  kwitansi    Kwitansi?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ TAGIHAN (Bills) ============
model Tagihan {
  id            String    @id @default(cuid())
  kode          String    @unique
  wargaId       String
  warga         Warga     @relation(fields: [wargaId], references: [id])
  jenis         String    // iuran_bulanan / keamanan / kebersihan / lainnya
  periode       String    // e.g. "2026-08"
  jumlah        Int
  tanggalJatuhTempo DateTime
  status        String    @default("belum_bayar") // belum_bayar / lunas / telat
  tanggalBayar  DateTime?
  metode        String?
  denda         Int       @default(0)
  keterangan    String?
  kwitansi      Kwitansi[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ KEGIATAN (Activities) ============
model Kegiatan {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String
  kategori     String   @default("Sosial") // Sosial / Keamanan / Kebersihan / Pertemuan / Gotong Royong
  tanggalMulai DateTime
  tanggalSelesai DateTime?
  lokasi       String?
  status       String   @default("akan_datang") // akan_datang / berlangsung / selesai / dibatalkan
  fotoUrl      String?
  jumlahPeserta Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ PENGUMUMAN (Announcements) ============
model Pengumuman {
  id         String   @id @default(cuid())
  judul      String
  konten     String
  kategori   String   @default("Umum") // Umum / Penting / Mendesak / Acara
  prioritas  String   @default("normal") // normal / penting / mendesak
  status     String   @default("aktif") // aktif / arsip
  penulis    String?
  tanggal    DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ PENGADUAN (Complaints) ============
model Pengaduan {
  id         String   @id @default(cuid())
  kode       String   @unique
  judul      String
  deskripsi  String
  kategori   String   // Keamanan / Fasilitas / Kebersihan / Sosial / Lainnya
  lokasi     String?
  fotoUrl    String?
  status     String   @default("baru") // baru / proses / selesai / ditolak
  pelapor    String
  wargaId    String?
  warga      Warga?   @relation(fields: [wargaId], references: [id])
  tanggapan  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ KWITANSI (Receipts) ============
model Kwitansi {
  id          String   @id @default(cuid())
  kode        String   @unique
  transaksiId String?  @unique
  transaksi   Transaksi? @relation(fields: [transaksiId], references: [id])
  tagihanId   String?
  tagihan     Tagihan? @relation(fields: [tagihanId], references: [id])
  wargaId     String?
  warga       Warga?   @relation(fields: [wargaId], references: [id])
  tanggal     DateTime @default(now())
  nominal     Int
  penerima    String?
  pembayar    String?
  keterangan  String?
  ttdUrl      String?
  createdAt   DateTime @default(now())
}

// ============ PENGURUS (Organization) ============
model Pengurus {
  id        String   @id @default(cuid())
  nama      String
  jabatan   String
  urutan    Int      @default(0)
  telepon   String?
  email     String?
  foto      String?
  periode   String   @default("2024-2027")
  bidang    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ TAUTAN (Links & Contacts) ============
model Tautan {
  id        String   @id @default(cuid())
  judul     String
  url       String
  kategori  String   @default("Umum") // Sosial Media / Pemerintah / Layanan / Kontak / Umum
  logo      String?
  deskripsi String?
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
}

// ============ MARKETPLACE ============
model Marketplace {
  id          String   @id @default(cuid())
  nama        String
  kategori    String   // Makanan / Jasa / Barang / Kuliner / Otomotif / Lainnya
  harga       Int
  deskripsi   String
  fotoUrl     String?
  penjual     String
  telepon     String
  alamat      String?
  kondisi     String   @default("baru") // baru / bekas
  status      String   @default("tersedia") // tersedia / terjual
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ TRAFIK WEBSITE (Traffic stats) ============
model TrafikWebsite {
  id        String   @id @default(cuid())
  tanggal   DateTime
  pageViews Int      @default(0)
  visitors  Int      @default(0)
  sessions  Int      @default(0)
  device    String   @default("mobile") // mobile / desktop / tablet
  referrer  String?
  page      String?
  createdAt DateTime @default(now())
}

// ============ PENGATURAN (Settings) ============
model Pengaturan {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  kategori  String   @default("umum")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
